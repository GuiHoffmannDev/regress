# --- Ollama (local, free). Requires `ollama pull qwen3.5:4b qwen3:8b`. ---
OPENAI_BASE_URL=http://localhost:11434/v1
# Ollama ignores the key, but the SDK requires a non-empty value.
OPENAI_API_KEY=ollama
JUDGE_MODEL=qwen3:8b
# "none" disables Qwen3 thinking: ~1s instead of 10-30s per call.
JUDGE_REASONING_EFFORT=none
REGRESS_CONCURRENCY=4

# --- OpenAI instead: remove OPENAI_BASE_URL and JUDGE_REASONING_EFFORT, then ---
# OPENAI_API_KEY=sk-...
# JUDGE_MODEL=gpt-4o

# Alerts (sent only for warn/fail runs)
SLACK_WEBHOOK_URL=
# Link shown on the Slack button
REPORT_URL=

# Gates. Deltas are absolute pass-rate drops (0.03 = 3 percentage points).
REGRESS_WARN_DELTA=0.03
REGRESS_CRITICAL_DELTA=0.08
REGRESS_DRIFT_FLOOR=0.90
REGRESS_DRIFT_WINDOW=7
REGRESS_MIN_SUMMARY_SCORE=3
